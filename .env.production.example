# ---------------------------------------------------------------------------
# ULS HDC Cumulative Record System: PRODUCTION settings
#
# Copy to `.env` on the server, fill in every value marked CHANGE, then run
#   php artisan key:generate --force
# Never commit the real `.env`. Keep a copy of APP_KEY and BACKUP_ARCHIVE_PASSWORD
# in the HDC password manager: without them, encrypted data and backups cannot be read.
# See README.md, "Deploying to shared hosting".
# ---------------------------------------------------------------------------

APP_NAME="ULS HDC"
APP_ENV=production
# Generated by `php artisan key:generate --force`. Encrypts sessions and the confidential
# Form 8 notes in the database: if it is lost, those notes cannot be decrypted.
APP_KEY=
# Must stay false in production: debug pages show configuration and data.
APP_DEBUG=false
# CHANGE: the real HTTPS address.
APP_URL=https://hdc.example.edu.ph
# Redirect http:// to https:// and generate https:// links (on by default when APP_ENV=production).
FORCE_HTTPS=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Daily log files, warnings and errors only (kept 14 days by default).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# CHANGE: database created in the hosting panel (MySQL 8).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=HDC_DATABASE
DB_USERNAME=root
DB_PASSWORD=
# Only if `which mysqldump` is not found by backups, e.g. /usr/bin
# DB_DUMP_BINARY_PATH=

# Sessions: database-backed, encrypted, HTTPS-only cookie, signed out after 60 idle minutes.
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database

# Queue: database driver. On shared hosting without Supervisor, let the every-minute
# cron also run a short-lived queue worker. Set to false when Supervisor runs queue:work.
QUEUE_CONNECTION=database
QUEUE_WORKER_VIA_SCHEDULER=true

# Time zone for scheduled tasks (backups run at 01:30).
SCHEDULE_TIMEZONE=Asia/Manila

# CHANGE: outgoing mail (password resets, backup failure alerts). Hostinger example shown.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=CHANGE_noreply@hdc.example.edu.ph
MAIL_PASSWORD=CHANGE_mail_password
MAIL_FROM_ADDRESS="CHANGE_noreply@hdc.example.edu.ph"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# CHANGE: the single HDC Director account, created by `php artisan db:seed --force`.
# The seeder refuses passwords that are shorter than 10 characters or lack upper/lower case, a number or a symbol,
# and refuses this placeholder. The director should change it after the first login.
DIRECTOR_EMAIL=CHANGE_director@uls.edu.ph
DIRECTOR_PASSWORD=ChangeMe-Strong-Passw0rd
DIRECTOR_FIRST_NAME=HDC
DIRECTOR_LAST_NAME=Director

# Reports: counts from 1 to (this - 1) are shown as "<5". Confirm with HDC before changing.
HDC_MIN_GROUP_SIZE=5

# Backups (FR-11): database + private uploads, daily, AES-256 encrypted, kept 30 days.
# CHANGE: a long random password (e.g. 24+ characters). `backup:run` refuses to run in
# production without it. Store it OUTSIDE this server; you need it to restore.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NAME=uls-hdc
BACKUP_DISKS=backups
BACKUP_KEEP_DAYS=30
# Optional: a folder outside the app directory, e.g. /home/USER/hdc-backups
# BACKUP_PATH=
# Who is e-mailed when a backup fails or is missing (defaults to DIRECTOR_EMAIL).
BACKUP_NOTIFICATION_EMAIL=
